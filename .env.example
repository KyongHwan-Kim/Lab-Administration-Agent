# .env.example 을 .env 로 복사한 뒤 값을 채웁니다. .env 는 저장소에 올리지 않습니다.

# 로그인 세션 서명 키. 긴 임의 문자열을 넣습니다.
SECRET_KEY=change-me-to-a-long-random-string

# 처음 실행할 때 만들어지는 관리자 계정. 이미 계정이 있으면 비밀번호는 바뀌지 않습니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# PostgreSQL. 최초 기동 후에 바꾸면 기존 데이터 볼륨에는 반영되지 않습니다.
POSTGRES_USER=labadmin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=labadmin

# 사용 내역을 읽어 오는 Google 스프레드시트 ID
SHEET_ID=your-google-sheet-id
SHEET_CACHE_SECONDS=300

# 영수증·배달 내역 항목 추출. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-
OPENAI_MODEL=gpt-5.6-luna

# HTTPS. 둘 다 채우면 nginx 가 Let's Encrypt 인증서를 발급하고 12시간마다 갱신합니다.
# 비우면 80번 포트의 HTTP 로만 엽니다. 발급 테스트는 CERTBOT_STAGING=1 입니다.
DOMAIN=
CERTBOT_EMAIL=
CERTBOT_STAGING=0
